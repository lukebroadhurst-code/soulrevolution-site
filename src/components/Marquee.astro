---
interface Props { items: string[]; class?: string }
const { items, class: cls = '' } = Astro.props;
---
<div class:list={['marquee', cls]} aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => (
      <ul>
        {items.map((t) => (<li>{t}<i>✺</i></li>))}
      </ul>
    ))}
  </div>
</div>
<style>
  .marquee { overflow: hidden; border-block: 1px solid color-mix(in srgb, currentColor 22%, transparent); padding-block: 1rem; }
  .track { display: flex; width: max-content; animation: slide 48s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  ul { display: flex; list-style: none; margin: 0; padding: 0; }
  li { font-family: var(--font-display); font-size: clamp(1.1rem, 0.9rem + 1vw, 1.7rem); white-space: nowrap; padding-inline: 1.2rem; display: flex; align-items: center; gap: 2.4rem; font-style: italic; }
  i { font-style: normal; color: var(--sun); font-size: 0.8em; }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
