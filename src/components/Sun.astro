---
// The signature motif: a woodcut-style sun whose rays slowly turn.
// Colours follow the festival mark (coral → sun → teal tips).
interface Props { class?: string; rays?: number; face?: boolean }
const { class: cls = '', rays = 20, face = false } = Astro.props;
const R = 100, r0 = 62;
const items = Array.from({ length: rays }, (_, i) => {
  const a = (i / rays) * Math.PI * 2;
  const long = i % 2 === 0;
  const len = long ? 96 : 80;
  const w = long ? 0.11 : 0.09;
  const p = (ang: number, rad: number) => `${(Math.cos(ang) * rad).toFixed(2)},${(Math.sin(ang) * rad).toFixed(2)}`;
  return { d: `M ${p(a - w, r0)} L ${p(a, len)} L ${p(a + w, r0)} Z`, long };
});
---
<svg class:list={['sun', cls]} viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="sunDisc" cx="40%" cy="35%" r="75%">
      <stop offset="0" stop-color="#ffe4a8" />
      <stop offset="0.45" stop-color="#ffb347" />
      <stop offset="1" stop-color="#f2644a" />
    </radialGradient>
    <linearGradient id="rayG" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffb347" />
      <stop offset="1" stop-color="#f2644a" />
    </linearGradient>
  </defs>
  <g class="sun-rays">
    {items.map((it) => (
      <path d={it.d} fill={it.long ? 'url(#rayG)' : '#1f9aa3'} stroke="#1f1e3d" stroke-width="1.4" stroke-linejoin="round" />
    ))}
  </g>
  <circle r="58" fill="url(#sunDisc)" stroke="#1f1e3d" stroke-width="2.4" />
  <circle r="50" fill="none" stroke="#1f1e3d" stroke-width="0.8" stroke-dasharray="1.5 3.5" opacity="0.55" />
  {face && (
    <g fill="none" stroke="#1f1e3d" stroke-width="2.2" stroke-linecap="round">
      <path d="M-24 -4 q8 -8 16 0 M8 -4 q8 -8 16 0" />
      <path d="M-12 22 q12 9 24 0" />
    </g>
  )}
</svg>
<style>
  .sun { width: 100%; height: auto; overflow: visible; }
  .sun-rays { transform-origin: 0 0; animation: spin 140s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
