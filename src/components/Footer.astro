---
import { SITE, NAV } from '../data/site';
import Sun from './Sun.astro';
import mark from '../assets/brand/mark.svg';
const year = new Date().getFullYear();
---
<footer class="foot on-night grain">
  <div class="sun-wrap" aria-hidden="true"><Sun /></div>
  <div class="wrap top">
    <div class="lead">
      <img src={mark.src} alt="" width="110" height="78" loading="lazy" />
      <p class="tag">{SITE.tagline}.</p>
      <p class="muted">{SITE.theme} · {SITE.dateShort}<br />{SITE.venue.name}, {SITE.venue.locality}</p>
      <a class="btn btn-sun" href="/tickets/">Get tickets</a>
    </div>

    <nav aria-label="Footer" class="cols">
      <div>
        <h2>Festival</h2>
        <ul>
          <li><a href="/festival/">The Festival</a></li>
          <li><a href="/lineup/">Line-up</a></li>
          <li><a href="/tickets/">Tickets</a></li>
          <li><a href="/plan/">Plan your trip</a></li>
          <li><a href="/important-information-faqs/">FAQs</a></li>
          <li><a href="/gallery/">Gallery</a></li>
        </ul>
      </div>
      <div>
        <h2>About</h2>
        <ul>
          {NAV.find((n) => n.label === 'About')!.children!.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          <li><a href="/participate/">Get involved</a></li>
        </ul>
      </div>
      <div>
        <h2>Beyond</h2>
        <ul>
          <li><a href="/retreats-intimate-events/">Retreats &amp; events</a></li>
          <li><a href="/journal/">Journal</a></li>
          <li><a href="/documentary/">Documentary</a></li>
          <li><a href="/connect/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Say hello</h2>
        <ul>
          <li><a href={`mailto:${SITE.emails.general}`}>{SITE.emails.general}</a></li>
          <li><a href={SITE.links.instagram} rel="noopener">Instagram</a></li>
          <li><a href={SITE.links.facebook} rel="noopener">Facebook</a></li>
          <li><a href={SITE.links.youtube} rel="noopener">YouTube</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap base">
    <p>© {year} Soul Revolution Festival. Alcohol &amp; substance free. All are welcome.</p>
    <p>
      <a href="/privacy/">Privacy</a>
      <button type="button" data-calm aria-pressed="false">Calm mode: <span>off</span></button>
    </p>
  </div>
</footer>

<style>
  .foot { position: relative; overflow: clip; padding-top: clamp(4rem, 8vw, 7rem); background: linear-gradient(180deg, var(--night), #1a1235 60%, #3a1d4a); }
  .sun-wrap { position: absolute; left: 50%; bottom: calc(min(90vw, 60rem) * -0.62); width: min(90vw, 60rem); transform: translateX(-50%); opacity: 0.55; pointer-events: none; }
  .top { position: relative; z-index: 1; display: grid; gap: 3rem; padding-bottom: clamp(7rem, 18vw, 14rem); }
  @media (min-width: 960px) { .top { grid-template-columns: 1fr 2.2fr; gap: 5rem; } }
  .lead img { width: 7rem; margin-bottom: 1.5rem; }
  .tag { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.05; margin: 0 0 1rem; font-variation-settings: 'opsz' 72, 'SOFT' 80, 'WONK' 1; max-width: 12ch; }
  .cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; }
  @media (min-width: 700px) { .cols { grid-template-columns: repeat(4, 1fr); } }
  h2 { font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--sun); margin: 0 0 1rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.55rem; }
  .cols a { text-decoration: none; opacity: 0.88; overflow-wrap: anywhere; }
  .cols a:hover { opacity: 1; color: var(--glow); text-decoration: underline; }
  .base { position: relative; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; padding-block: 1.4rem; border-top: 1px solid rgba(255,255,255,.14); font-size: 0.85rem; background: rgba(16,15,36,.55); backdrop-filter: blur(6px); width: 100%; max-width: none; padding-inline: var(--gutter); padding-right: 5rem; }
  .base p { margin: 0; display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; }
  .base button { background: none; border: 1px solid rgba(255,255,255,.3); color: inherit; border-radius: 999px; padding: 0.35em 0.9em; font: inherit; cursor: pointer; }
  .base button:hover { border-color: var(--sun); }
</style>
