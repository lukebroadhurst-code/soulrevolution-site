---
import { TICKETS, PAYMENT_PLAN_MONTHS, SITE } from '../data/site';
const adults = TICKETS.filter((t) => t.kind === 'adult');
const others = TICKETS.filter((t) => t.kind !== 'adult');
const fmt = (n: number) => (n === 0 ? 'Free' : `£${n}`);
---
<div class="calc" data-calc data-tickets={JSON.stringify(TICKETS.map(({ id, price }) => ({ id, price })))}>
  <div class="calc-main">
    <fieldset class="tier">
      <legend>Choose your adult ticket</legend>
      <div class="tiers">
        {adults.map((t, i) => (
          <label class="tier-card">
            <input type="radio" name="adult" value={t.id} checked={i === 0} />
            <span class="tc-name">{t.name}</span>
            <span class="tc-price">£{t.price}</span>
            {t.tag && <span class="pill coral">{t.tag} left</span>}
            <span class="tc-note">{t.note}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="rows">
      <div class="row" data-row="adult">
        <div><b>Adults</b><small>Selected ticket above</small></div>
        <div class="stepper" data-step="adult"><button type="button" aria-label="Fewer adults">−</button><output>1</output><button type="button" aria-label="More adults">+</button></div>
      </div>
      {others.map((t) => (
        <div class="row" data-row={t.id}>
          <div><b>{t.name}</b><small>{t.note} · <strong>{fmt(t.price)}</strong></small></div>
          <div class="stepper" data-step={t.id}><button type="button" aria-label={`Fewer ${t.name}`}>−</button><output>0</output><button type="button" aria-label={`More ${t.name}`}>+</button></div>
        </div>
      ))}
    </div>
  </div>

  <div class="receipt" role="region" aria-label="Your ticket total" aria-live="polite">
    <h2 class="h3">Your total</h2>
    <dl data-lines></dl>
    <div class="total"><span>Total</span><b data-total>£255</b></div>
    <label class="plan-label" for="plan">Spread the cost</label>
    <select id="plan" data-plan>
      <option value="1">Pay in full</option>
      {PAYMENT_PLAN_MONTHS.map((m) => <option value={m}>{m} monthly payments</option>)}
    </select>
    <p class="per" data-per hidden></p>
    <a class="btn btn-sun btn-lg" href={SITE.links.tickets} rel="noopener">Book on Dandelion
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <p class="fine">Indicative total from prices checked {SITE.ticketsCheckedOn}. Booking fees and final availability are shown on Dandelion at checkout. Payment plans (Klarna or GoCardless) are subject to approval and how far away the festival is when you book.</p>
  </div>
</div>

<style>
  .calc { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 960px) { .calc { grid-template-columns: 1.5fr 1fr; gap: 3rem; } }
  fieldset { border: 0; padding: 0; margin: 0 0 2rem; }
  legend { font-family: var(--font-display); font-size: 1.5rem; margin-bottom: 1rem; font-variation-settings: 'opsz' 48, 'SOFT' 50; }
  .tiers { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
  .tier-card { position: relative; display: grid; gap: 0.25rem; padding: 1.2rem 1.2rem 1.1rem; border-radius: 1.1rem; background: #fff; cursor: pointer; border: 2px solid transparent; transition: .3s var(--ease); box-shadow: 0 1px 0 rgba(31,30,61,.06); font-weight: 400; }
  .tier-card input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .tier-card:has(input:checked) { border-color: var(--coral); transform: translateY(-3px); box-shadow: 0 18px 36px -18px rgba(242,100,74,.6); }
  .tier-card:has(input:focus-visible) { outline: 3px solid var(--sun); outline-offset: 3px; }
  .tc-name { font-weight: 700; }
  .tc-price { font-family: var(--font-display); font-size: 2.6rem; line-height: 1; font-variation-settings: 'opsz' 96, 'SOFT' 60; }
  .tc-note { font-size: 0.8rem; color: var(--muted); }
  .tier-card .pill { justify-self: start; }

  .rows { display: grid; gap: 0.6rem; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.9rem 1.1rem; background: #fff; border-radius: 1rem; }
  .row b { display: block; }
  .row small { color: var(--muted); font-size: 0.82rem; }
  .stepper { display: flex; align-items: center; gap: 0.2rem; background: var(--paper); border-radius: 999px; padding: 0.2rem; }
  .stepper button { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 0; background: var(--ink); color: #fff; font-size: 1.3rem; line-height: 1; cursor: pointer; transition: .2s; }
  .stepper button:hover { background: var(--coral); }
  .stepper button:disabled { opacity: .3; cursor: not-allowed; }
  .stepper output { min-width: 2.2rem; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }

  .receipt { background: var(--ink); color: var(--paper); border-radius: 1.5rem; padding: clamp(1.4rem, 3vw, 2.2rem); position: sticky; top: calc(var(--header-h) + 1rem); display: grid; gap: 1rem; }
  .receipt .h3 { font-size: 1.4rem; }
  dl { margin: 0; display: grid; gap: 0.5rem; }
  dl :global(div) { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.95rem; border-bottom: 1px dashed rgba(255,255,255,.2); padding-bottom: 0.5rem; }
  dl :global(dt) { opacity: .85; font-family: var(--font-body); font-size: inherit; margin: 0; } dl :global(dd) { margin: 0; font-variant-numeric: tabular-nums; font-weight: 600; color: var(--paper); }
  .total { display: flex; justify-content: space-between; align-items: baseline; }
  .total b { font-family: var(--font-display); font-size: 3rem; line-height: 1; color: var(--sun); font-variant-numeric: tabular-nums; font-variation-settings: 'opsz' 96, 'SOFT' 60; }
  .plan-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .16em; color: var(--glow); }
  select { border-radius: 999px; background: rgba(255,255,255,.08); color: inherit; }
  select option { color: var(--ink); }
  .per { margin: 0; font-weight: 600; color: var(--glow); }
  .fine { font-size: .78rem; opacity: .7; margin: 0; line-height: 1.5; }
  dl :global(.empty) { opacity: .7; font-size: .9rem; margin: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const catalog = Object.fromEntries((JSON.parse(root.dataset.tickets!) as { id: string; price: number }[]).map((t) => [t.id, t.price]));
    const names: Record<string, string> = {};
    root.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => (names[r.dataset.row!] = r.querySelector('b')!.textContent!));
    root.querySelectorAll<HTMLInputElement>('input[name=adult]').forEach((i) => (names[i.value] = i.closest('label')!.querySelector('.tc-name')!.textContent!));

    const qty: Record<string, number> = { adult: 1 };
    const lines = root.querySelector('[data-lines]')!;
    const totalEl = root.querySelector('[data-total]')!;
    const plan = root.querySelector<HTMLSelectElement>('[data-plan]')!;
    const per = root.querySelector<HTMLElement>('[data-per]')!;
    const gbp = (n: number) => '£' + (Number.isInteger(n) ? n : n.toFixed(2));

    const render = () => {
      const adultId = root.querySelector<HTMLInputElement>('input[name=adult]:checked')!.value;
      let total = 0;
      const out: string[] = [];
      for (const [k, n] of Object.entries(qty)) {
        if (!n) continue;
        const id = k === 'adult' ? adultId : k;
        const sub = catalog[id] * n;
        total += sub;
        out.push(`<div><dt>${n} × ${names[id]}</dt><dd>${sub === 0 ? 'Free' : gbp(sub)}</dd></div>`);
      }
      lines.innerHTML = out.length ? out.join('') : '<p class="empty">Add a ticket to see your total.</p>';
      totalEl.textContent = gbp(total);
      const months = Number(plan.value);
      per.hidden = months === 1 || total === 0;
      if (!per.hidden) per.textContent = `≈ ${gbp(Math.ceil((total / months) * 100) / 100)} a month for ${months} months`;
      root.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => {
        const k = s.dataset.step!;
        s.querySelector('output')!.textContent = String(qty[k] ?? 0);
        s.querySelectorAll('button')[0].disabled = (qty[k] ?? 0) <= 0;
        s.querySelectorAll('button')[1].disabled = (qty[k] ?? 0) >= 12;
      });
    };

    root.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => {
      const k = s.dataset.step!;
      const [minus, plus] = s.querySelectorAll('button');
      minus.addEventListener('click', () => { qty[k] = Math.max(0, (qty[k] ?? 0) - 1); render(); });
      plus.addEventListener('click', () => { qty[k] = Math.min(12, (qty[k] ?? 0) + 1); render(); });
    });
    root.addEventListener('change', render);
    render();
  });
</script>
