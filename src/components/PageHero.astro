---
import Watermark from './Watermark.astro';
import Divider from './Divider.astro';
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';
interface Props { eyebrow?: string; title: string; lede?: string; image?: ImageMetadata; alt?: string; position?: string; tone?: 'night' | 'ink' | 'teal' }
const { eyebrow, title, lede, image, alt = '', position = 'center', tone = 'night' } = Astro.props;
---
<section class:list={['page-hero grain', `on-${tone}`]}>
  {image && (
    <div class="bg" aria-hidden="true">
      <Photo src={image} alt={alt} loading="eager" fetchpriority="high" sizes="100vw" position={position} />
    </div>
  )}
  <Watermark kind="sunmoon" pos="right -8rem center" size="min(64vw, 52rem)" opacity={0.13} tone="var(--paper)" />
  <div class="wrap rel">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h1">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <Divider class="left" />
    <slot />
  </div>
</section>
<style>
  .bg { position: absolute; inset: 0; z-index: -2; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .page-hero.on-night, .page-hero.on-ink, .page-hero.on-teal { isolation: isolate; }
  .page-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, rgba(16,15,36,.94) 18%, rgba(16,15,36,.55) 70%, rgba(16,15,36,.35)), linear-gradient(0deg, rgba(16,15,36,.7), transparent 40%); }
  .rel { position: relative; z-index: 1; }
</style>
