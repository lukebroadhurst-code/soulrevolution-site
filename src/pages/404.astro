---
import Base from '../layouts/Base.astro';
import Watermark from '../components/Watermark.astro';
---
<Base title="Page not found" noindex newsletter={false}>
  <section class="lost on-night grain">
    <Watermark kind="moon" pos="right -6rem center" size="min(80vw, 60rem)" opacity={0.16} tone="var(--sun)" />
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="display">Lost? That’s<br />part of the path.</h1>
      <p class="lede">The page you wanted isn’t here, but the festival is. Let’s get you back.</p>
      <p><a class="btn btn-sun btn-lg" href="/">Back to the beginning</a> <a class="btn btn-ghost btn-lg" href="/tickets/">Tickets</a></p>
    </div>
  </section>
</Base>
<style>
  .lost { min-height: 100svh; display: grid; align-items: center; position: relative; overflow: clip; padding-top: var(--header-h); } .lost .wrap { position: relative; z-index: 1; } .lost .display { margin: .3em 0; } .lost .lede { margin-bottom: 2rem; }
</style>
