---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { SITE, STAGES, OFFERINGS } from '../data/site';
import { photos } from '../data/photos';
const imgs: Record<string, any> = { music: photos.music, ceremony: photos.altar, ignite: photos.ignite, talks: photos.talks, workshop: photos.workshop, family: photos.family, healing: photos.healing };
---
<Base title="The Festival" description="Five days of music, ceremony, healing and community at Weston Park. Explore the stages, spaces and experiences of Soul Revolution Festival.">
  <PageHero eyebrow="The festival" title="Where the music meets the medicine." lede="Soul Revolution is a transformational gathering of holistic health, spirituality, consciousness, self-expression and empowerment. Alcohol and substance-free, so it is safe for families and deeply open for everyone." image={photos.nightFireSong} alt="" position="50% 65%" />

  <section class="section">
    <div class="wrap intro">
      <div class="prose">
        <h2 class="h2">What you’ll find</h2>
        <p>Incredible music from artists and genres around the globe, curated to create a heart-opening, joy-filled celebration of life. Indigenous ceremonies and fire walking. The haka. Foraging. Ice baths. Authentic African drumming. Workshops, revolutionary talks, a Healing Village, a children’s tent, and a thousand acres to wander.</p>
        <p>Unity, acceptance and love are at the heart of everything we do. Soul Revolution welcomes people of all ages and backgrounds.</p>
        <ul class="chips">{OFFERINGS.map((o) => <li>{o}</li>)}</ul>
      </div>
      <figure class="fig"><Photo src={photos.tentDance} alt="Festival-goers dancing arm in arm in a canvas tent" sizes="(max-width:900px) 90vw, 520px" widths={[480, 800, 1080]} /></figure>
    </div>
  </section>

  <section class="section on-night grain">
    <div class="wrap">
      <p class="eyebrow">Stages &amp; spaces</p>
      <h2 class="h2">Twelve-plus places to lose yourself.</h2>
      <ol class="list">
        {STAGES.map((s, i) => (
          <li class="reveal">
            <div class="ph"><Photo src={imgs[s.photo]} alt="" sizes="(max-width:760px) 90vw, 360px" widths={[360, 720]} /></div>
            <div>
              <p class="pill">{s.kind}</p>
              <h3 class="h3">{s.name}</h3>
              <p>{s.blurb}</p>
              <ul>{s.facts.map((f) => <li>{f}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Food &amp; drink</p>
        <h2 class="h2">Nourished, and sober.</h2>
        <p>Organic vegan meals throughout the weekend, with organic meat and wild-caught options too. More than 30 traders. No alcohol sold or permitted, which is exactly what makes the late-night dancefloor and the family tent feel so open. Bring a reusable bottle, cup and cutlery.</p>
      </div>
      <div>
        <p class="eyebrow">Welfare</p>
        <h2 class="h2">Held, always.</h2>
        <p>A 24-hour security and medical team, and PsyCare UK in a dedicated welfare tent for anyone who feels overwhelmed. Around twenty managers and 300 volunteers look after the village.</p>
      </div>
    </div>
    <div class="wrap"><a class="btn btn-lg" href="/tickets/">Get tickets</a> <a class="btn btn-ghost btn-lg" href="/important-information-faqs/">Read the FAQs</a></div>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 900px) { .intro { grid-template-columns: 1.2fr 1fr; gap: 5rem; } }
  .chips { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .chips li { margin: 0; padding: .4em 1em; border-radius: 999px; background: var(--sand); font-weight: 600; font-size: .9rem; }
  .fig { margin: 0; border-radius: 2rem 2rem 8rem 2rem; overflow: hidden; } .fig :global(img) { width: 100%; height: auto; }
  .list { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; gap: 3rem; }
  .list > li { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 760px) { .list > li { grid-template-columns: 1fr 1.3fr; gap: 3rem; } .list > li:nth-child(even) .ph { order: 2; } }
  .ph { border-radius: 1.6rem; overflow: hidden; aspect-ratio: 4/3; } .ph :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .list .pill { margin-bottom: .8rem; } .list h3 { margin-bottom: .6rem; font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem); }
  .list ul { padding-left: 1.2em; color: var(--glow); font-weight: 600; font-size: .95rem; }
  .two { display: grid; gap: 3rem; margin-bottom: 3rem; } @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; gap: 5rem; } }
</style>
