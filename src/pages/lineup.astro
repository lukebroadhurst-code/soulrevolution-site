---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { SITE, LINEUP_2026 as L } from '../data/site';
import { photos } from '../data/photos';
---
<Base title="Line-up" description="The 2027 line-up is being curated. Apply to play or facilitate by 11 November, or explore the 2026 line-up of musicians, DJs, faith leaders and teachers.">
  <PageHero eyebrow="Line-up · 2027" title="The 2027 line-up is being woven." lede="Over 200 musicians, teachers, faith leaders and facilitators gather each year. Names are announced in waves, so join the list to hear first." image={photos.drummer} alt="" position="50% 30%">
    <div class="cta"><a class="btn btn-sun btn-lg" href="#news">Get line-up news</a> <a class="btn btn-ghost btn-lg" href="/participate/">Apply to play or teach</a></div>
  </PageHero>

  <section class="section-tight on-coral">
    <div class="wrap bar">
      <p><b>Applications open.</b> Music artists and facilitators: apply by <b>{SITE.applicationDeadline}</b>.</p>
      <p><a class="btn btn-sm" style="--bg:var(--night)" href={SITE.links.musicArtists} rel="noopener">Music artists</a> <a class="btn btn-sm" style="--bg:var(--night)" href={SITE.links.facilitators} rel="noopener">Facilitators</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">The archive</p>
      <h2 class="h2">What 2026 looked like.</h2>
      <p class="lede">A taste of the breadth: global live music, DJs, wisdom-keepers, healers and teachers, all in one village.</p>

      <div class="poster">
        <a href="/gallery/" class="p" aria-label="2026 line-up poster">
          <Photo src={photos.lineupPoster2026} alt="Soul Revolution Festival 2026 line-up poster listing live music, DJs, faith leaders, facilitators, stage collaborations and offerings" sizes="(max-width:900px) 90vw, 440px" widths={[440, 880, 1080]} />
        </a>
        <div class="roster">
          <h3 class="eyebrow">Live music</h3>
          <p class="top">{L.headliners.map((n) => <span>{n}</span>)}</p>
          <p class="mid">{L.music.map((n) => <span>{n}</span>)}</p>
          <h3 class="eyebrow">DJs</h3>
          <p class="mid dj">{L.djs.map((n) => <span>{n}</span>)}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section on-night grain">
    <div class="wrap">
      <p class="eyebrow">Faith leaders, facilitators &amp; guest speakers</p>
      <h2 class="h2">Wisdom from every tradition.</h2>
      <p class="mid big">{L.speakers.map((n) => <span>{n}</span>)}</p>
      <h3 class="eyebrow" style="margin-top:3rem">Stage collaborations</h3>
      <p class="mid big collab">{L.collabs.map((n) => <span>{n}</span>)}</p>
      <p class="muted note">2026 line-up shown for reference. The 2027 line-up will differ.</p>
    </div>
  </section>
</Base>

<style>
  .cta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2rem; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; } .bar p { margin: 0; }
  .poster { display: grid; gap: 3rem; margin-top: 3rem; align-items: start; }
  @media (min-width: 960px) { .poster { grid-template-columns: 22rem 1fr; gap: 5rem; } .p { position: sticky; top: calc(var(--header-h) + 1rem); } }
  .p { display: block; border-radius: 1.2rem; overflow: hidden; box-shadow: 0 30px 60px -30px rgba(31,30,61,.6); transition: transform .5s var(--ease); } .p:hover { transform: rotate(-1deg) scale(1.01); } .p :global(img) { width: 100%; height: auto; }
  .roster h3 { margin: 2rem 0 1rem; } .roster h3:first-child { margin-top: 0; }
  .top { display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; font-family: var(--font-display); font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem); line-height: 1.05; font-weight: 400; }
  .top span:nth-child(even) { color: var(--coral-ink); font-style: italic; }
  .mid { display: flex; flex-wrap: wrap; gap: .25rem 0; font-weight: 700; letter-spacing: .02em; font-size: 1.05rem; }
  .mid span::after { content: '·'; margin-inline: .7rem; color: var(--coral-ink); }
  .mid span:last-child::after { content: ''; }
  .dj { color: var(--teal-deep); }
  .big { font-family: var(--font-display); font-size: clamp(1.3rem, 1rem + 1.4vw, 2rem); line-height: 1.3; font-weight: 500; margin-top: 2rem; }
  .big span::after { color: var(--sun); }
  .collab { color: var(--glow); }
  .note { margin-top: 3rem; font-size: .9rem; }
</style>
